<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Permite tráfego HTTP (sem TLS) para todos os IPs de desenvolvimento.
        Em produção, remova este arquivo e use apenas HTTPS.

        IPs cobertos:
          localhost / 127.0.0.1  → API rodando no próprio dispositivo
          10.0.2.2               → Emulador Android Studio (AVD padrão) → host PC
          192.168.56.1           → Emulador Genymotion / AVD modo bridge → host PC
          192.168.15.x           → Rede Wi-Fi local (ajuste a faixa se necessário)
          192.168.1.x            → Rede Wi-Fi alternativa
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- AVD padrão (Android Studio Emulator) -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Genymotion / AVD bridge mode -->
        <domain includeSubdomains="false">192.168.56.1</domain>
        <!-- Rede local Wi-Fi — ajuste conforme seu roteador -->
        <domain includeSubdomains="true">192.168.15.187</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
    </domain-config>

    <!-- Bloqueia HTTP para qualquer outro host fora da lista acima -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>