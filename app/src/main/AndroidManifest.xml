<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="orionpay.maquinha_simulate">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:allowBackup="true"
        android:label="OrionPay"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- SplashActivity agora é a principal para evitar o erro de ActivityNotFound na MainActivity -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TransactionActivity agora lida com o NFC -->
        <activity
            android:name=".ui.transaction.TransactionActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.activities.DiagnosticActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- MainActivity removida pois a lógica de NFC foi movida para a TransactionActivity -->

    </application>

</manifest>